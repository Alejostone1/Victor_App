      "title": "Me gusta",
      "type": "learn",
      "icon": "👍",
      "grammarTip": {
        "es": "En inglés no se dice «me gusta»: se dice «yo gusto». I like coffee = me gusta el café. Para lo contrario: I don't like (no me gusta).",
        "example": "I like coffee. I don't like tea."
      },
