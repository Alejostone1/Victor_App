      "title": "¿Te gusta…?",
      "type": "learn",
      "icon": "❓",
      "grammarTip": {
        "es": "Para preguntar se empieza con «Do»: Do you like coffee? (¿Te gusta el café?). Se responde corto: Yes, I do. / No, I don't.",
        "example": "Do you like music? Yes, I do."
      },
      "vocab": [
        {"key":"phrase:do-you-like","en":"Do you like…?","es":"¿Te gusta…?"},
        {"key":"phrase:yes-i-do","en":"Yes, I do","es":"Sí (me gusta)"},
        {"key":"phrase:no-i-dont","en":"No, I don't","es":"No (no me gusta)"},
        {"key":"phrase:what-do-you-like","en":"What do you like?","es":"¿Qué te gusta?"}
      ],
      "exercises": [
