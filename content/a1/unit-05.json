    {
      "id": "a1-u05-l03",
      "title": "¿A qué te dedicas?",
      "type": "learn",
      "icon": "⛪",
      "grammarTip": {
        "es": "Antes de una profesión se pone «a» (un/una): I am a priest (Soy sacerdote). Si la palabra empieza con vocal se usa «an»: an engineer.",
        "example": "I am a priest. I am a teacher."
      },
      "vocab": [
        {"key": "phrase:what-do-you-do", "en": "What do you do?", "es": "¿A qué te dedicas?"},
