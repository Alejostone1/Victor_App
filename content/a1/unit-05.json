    {
      "id": "a1-u05-l01",
      "title": "¿Cómo te llamas?",
      "type": "learn",
      "icon": "🗣️",
      "grammarTip": {
        "es": "Para decir tu nombre usa «My name is…» (Mi nombre es…). También puedes decir «I am…» (Yo soy…). Las dos están bien.",
        "example": "My name is Victor. I am Victor."
      },
      "vocab": [
        {"key": "phrase:what-is-your-name", "en": "What is your name?", "es": "¿Cómo te llamas?"},
        {"key": "phrase:my-name-is", "en": "My name is…", "es": "Me llamo…"},
        {"key": "phrase:nice-to-meet-you", "en": "Nice to meet you", "es": "Mucho gusto"},
        {"key": "phrase:you-too", "en": "You too", "es": "Igualmente"}
      ],
