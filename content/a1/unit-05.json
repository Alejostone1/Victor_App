    {
      "id": "a1-u05-l02",
      "title": "¿De dónde eres?",
      "type": "learn",
      "icon": "🌎",
      "grammarTip": {
        "es": "«from» significa «de» cuando hablas de dónde eres. Y «I live in…» es «Vivo en…».",
        "example": "I am from Colombia. I live in Medellín."
      },
      "vocab": [
        {"key": "phrase:where-are-you-from", "en": "Where are you from?", "es": "¿De dónde eres?"},
        {"key": "phrase:i-am-from", "en": "I am from Colombia", "es": "Soy de Colombia"},
        {"key": "phrase:i-live-in", "en": "I live in…", "es": "Vivo en…"},
        {"key": "phrase:where-do-you-live", "en": "Where do you live?", "es": "¿Dónde vives?"}
      ],
      "exercises": [
