      "title": "¿Qué hora es?",
      "type": "learn",
      "icon": "🕖",
      "grammarTip": {
        "es": "Para la hora en punto se dice «o'clock»: It is seven o'clock (son las siete). Para la media hora: «half past»: It is half past seven (siete y media).",
        "example": "What time is it? It is seven o'clock."
      },
      "vocab": [
