    {
      "id": "a1-u07-l03",
      "title": "Práctica: ¿quién es?",
      "type": "practice",
      "icon": "🖼️",
      "grammarTip": {
        "es": "Para un hombre se dice «he» (él) y para una mujer «she» (ella). Con ellos se usa «is»: He is my brother. She is my mother.",
        "example": "He is my brother. She is my sister."
      },
      "vocab": [
        {"key": "phrase:he-is", "en": "He is…", "es": "Él es…"},
        {"key": "phrase:she-is", "en": "She is…", "es": "Ella es…"},
        {"key": "phrase:i-have-two-brothers", "en": "I have two brothers", "es": "Tengo dos hermanos"}
      ],
      "exercises": [
        {"id": "e1", "type": "fill_blank", "skill": "writing", "sentence": "___ is my mother.", "options": ["She", "He", "I"], "answer": "She", "errorTags": ["pronouns"]},
        {"id": "e2", "type": "fill_blank", "skill": "writing", "sentence": "He ___ my brother.", "options": ["is", "am", "are"], "answer": "is", "errorTags": ["verb_to_be"]},
        {"id": "e3", "type": "tap_choose", "skill": "listening", "audio": "He is my father", "word": "He is my father (Él es mi padre)", "options": [{"value": "father", "emoji": "👨"}, {"value": "mother", "emoji": "👩"}, {"value": "sister", "emoji": "👧"}], "answer": "father", "errorTags": ["family_words"]},
        {"id": "e4", "type": "flashcard", "skill": "vocabulary", "en": "I have two brothers", "es": "Tengo dos hermanos", "emoji": "👦👦", "hint": "ái jav tu bráders"},
        {"id": "e5", "type": "speak_repeat", "skill": "speaking", "text": "I have two brothers", "es": "Tengo dos hermanos", "minScore": 70},
        {"id": "e6", "type": "word_order", "skill": "writing", "es": "Ella es mi hermana", "words": ["sister", "She", "my", "is"], "answer": "She is my sister", "errorTags": ["pronouns"]},
        {"id": "e7", "type": "listen_type", "skill": "listening", "audio": "This is my family", "answer": "this is my family"},
