            {"speaker": "Tú", "en": "I have two brothers.", "es": "Yo tengo dos hermanos.", "userTurn": true},
            {"speaker": "Anna", "en": "And who are these people?", "es": "¿Y quiénes son estas personas?", "userTurn": false},
            {"speaker": "Tú", "en": "This is my community.", "es": "Esta es mi comunidad.", "userTurn": true},
