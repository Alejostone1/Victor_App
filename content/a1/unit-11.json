    {
      "id": "a1-u11-l03",
      "title": "Hay un parque",
      "type": "practice",
      "icon": "🌳",
      "grammarTip": {
        "es": "«Hay» se dice de dos formas: «There is» para una cosa (There is a park) y «There are» para varias (There are two churches).",
        "example": "There is a park. There are two churches."
      },
      "vocab": [
        {"key":"phrase:there-is","en":"There is…","es":"Hay… (una cosa)"},
        {"key":"phrase:there-are","en":"There are…","es":"Hay… (varias cosas)"}
      ],
