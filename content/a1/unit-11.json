    {
      "id": "a1-u11-l02",
      "title": "¿Dónde queda…?",
      "type": "learn",
      "icon": "🧭",
      "grammarTip": {
        "es": "Para preguntar por un lugar: «Where is the…?» (¿Dónde queda…?). Las indicaciones más útiles: turn left (gire a la izquierda), turn right (a la derecha), go straight (siga derecho).",
        "example": "Where is the bank? Turn left."
      },
      "vocab": [
        {"key":"phrase:where-is-the","en":"Where is the…?","es":"¿Dónde queda…?"},
        {"key":"phrase:turn-left","en":"Turn left","es":"Gire a la izquierda"},
        {"key":"phrase:turn-right","en":"Turn right","es":"Gire a la derecha"},
        {"key":"phrase:go-straight","en":"Go straight","es":"Siga derecho"},
        {"key":"vocab:near","en":"near","es":"cerca"},
        {"key":"vocab:far","en":"far","es":"lejos"}
      ],
      "exercises": [
        {"id":"e1","type":"flashcard","skill":"vocabulary","en":"Where is the bank?","es":"¿Dónde queda el banco?","emoji":"🏦","hint":"uér is de bank"},
        {"id":"e2","type":"speak_repeat","skill":"speaking","text":"Where is the bank?","es":"¿Dónde queda el banco?","minScore":70},
        {"id":"e3","type":"flashcard","skill":"vocabulary","en":"Turn left","es":"Gire a la izquierda","emoji":"⬅️","hint":"tern left"},
        {"id":"e4","type":"flashcard","skill":"vocabulary","en":"Turn right","es":"Gire a la derecha","emoji":"➡️","hint":"tern ráit"},
        {"id":"e5","type":"flashcard","skill":"vocabulary","en":"Go straight","es":"Siga derecho","emoji":"⬆️","hint":"góu stréit"},
        {"id":"e6","type":"tap_choose","skill":"listening","audio":"Turn right","word":"Turn right (a la derecha)","options":[{"value":"right","emoji":"➡️"},{"value":"left","emoji":"⬅️"},{"value":"straight","emoji":"⬆️"}],"answer":"right","errorTags":["directions"]},
        {"id":"e7","type":"tap_choose","skill":"listening","audio":"Turn left","word":"Turn left (a la izquierda)","options":[{"value":"straight","emoji":"⬆️"},{"value":"right","emoji":"➡️"},{"value":"left","emoji":"⬅️"}],"answer":"left","errorTags":["directions"]},
        {"id":"e8","type":"flashcard","skill":"vocabulary","en":"It is near","es":"Queda cerca","emoji":"📍","hint":"it is níer"},
