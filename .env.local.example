# Copia este archivo como .env.local y complétalo.
# Supabase → Project Settings → API Keys (usa la "publishable key" sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Solo servidor, para el seed. Nunca con prefijo NEXT_PUBLIC_
ANTHROPIC_API_KEY=                # Fase 5 (tutor IA). Sin ella, el tutor muestra "no está activado".
TUTOR_MODEL=                      # Opcional. Por defecto claude-haiku-5-5 (el más barato)
GEMINI_API_KEY=                   # Gratis en https://aistudio.google.com/apikey (se usa si no hay ANTHROPIC_API_KEY)
GEMINI_MODEL=                     # Opcional. Por defecto gemini-3.5-flash-lite
NEXT_PUBLIC_APP_NAME=EnglishPath
